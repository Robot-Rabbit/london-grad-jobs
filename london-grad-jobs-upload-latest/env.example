# Live job feed: add at least one. Both are free for personal/low-volume use.
# Reed: register at https://www.reed.co.uk/developers/jobseeker (key arrives by email)
REED_API_KEY=
# Adzuna: register at https://developer.adzuna.com (gives an app id + key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Careerjet: create a publisher account at https://www.careerjet.com/partners/ (API key)
CAREERJET_API_KEY=
# Jooble: request a free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# AI features (CV highlights, cover letters, smart match). Create a key at
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Max AI requests per visitor IP per hour
AI_LIMIT_PER_HOUR=40
PORT=5060

# Site-wide AI calls per day (protects your Anthropic bill)
AI_DAILY_LIMIT=500

# Email alerts
# SendGrid API key (Mail Send permission) and a verified sender address
SENDGRID_API_KEY=
ALERTS_FROM_EMAIL=
# Upstash Redis (Vercel Marketplace sets these automatically when you add it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; Vercel sends it to the daily alerts job
CRON_SECRET=
# Optional: the site's public address for links in emails, e.g. https://london-grad-jobs.vercel.app
PUBLIC_BASE_URL=
