# Live job feed: add at least one. Both are free for personal/low-volume use.
# Reed: register at https://www.reed.co.uk/developers/jobseeker (key arrives by email)
REED_API_KEY=
# Adzuna: register at https://developer.adzuna.com (gives an app id + key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI features (CV highlights, cover letters, smart match). Create a key at
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Max AI requests per visitor IP per hour
AI_LIMIT_PER_HOUR=40
PORT=5060

# Site-wide AI calls per day (protects your Anthropic bill)
AI_DAILY_LIMIT=500
